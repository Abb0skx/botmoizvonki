FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-delivery.txt .
RUN pip install --no-cache-dir -r requirements-delivery.txt

# Keep the delivery image isolated from unrelated project data and credentials,
# even if its Dockerfile-specific ignore file is accidentally changed later.
COPY app ./app

RUN addgroup --system delivery \
    && adduser --system --ingroup delivery delivery \
    && mkdir -p /app/data /app/cache \
    && chown -R delivery:delivery /app/data /app/cache

USER delivery

CMD ["python", "-m", "app.main"]
