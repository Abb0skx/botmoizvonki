# Create a dedicated bot with @BotFather. Never commit a real token.
SALES_PHOTO_BOT_TOKEN=
SALES_PHOTO_CHAT_ID=-1001234567890

# Google AI Studio / Gemini Developer API key.
GEMINI_API_KEY=
SALES_PHOTO_GEMINI_MODEL=gemini-2.5-flash

# Serper.dev Google Search API key. Search snippets are used only for verification.
SERPER_API_KEY=
SALES_PHOTO_SEARCH_COUNTRY=uz
SALES_PHOTO_SEARCH_LANGUAGE=ru

# Optional comma-separated Telegram user IDs allowed to select a manager.
# Empty means that only channel administrators may use the buttons.
SALES_PHOTO_ALLOWED_USER_IDS=

SALES_PHOTO_DB_PATH=/app/data/sales_photo.db
SALES_PHOTO_HEARTBEAT_PATH=/tmp/sales-photo-heartbeat
SALES_PHOTO_RECOGNITION_TIMEOUT_SECONDS=75
SALES_PHOTO_SEARCH_TIMEOUT_SECONDS=12
SALES_PHOTO_RECOGNITION_MAX_BYTES=12582912
SALES_PHOTO_MIN_CONFIDENCE=0.72
SALES_PHOTO_CACHE_DAYS=30
SALES_PHOTO_DELETE_RETRY_SECONDS=30
SALES_PHOTO_CONCURRENT_UPDATES=4
SALES_PHOTO_DROP_PENDING_ON_FIRST_START=true
SALES_PHOTO_LOG_LEVEL=INFO
