# Create a bot with @BotFather and add it to the delivery group and private
# location channel as an admin.
DELIVERY_BOT_TOKEN=123456:replace_me
DELIVERY_GROUP_ID=-1001234567890
DELIVERY_LOCATION_CHANNEL_ID=-1009876543210
DELIVERY_ORDERS_CHANNEL_ID=-1004459657817
DELIVERY_DB_PATH=data/delivery.db

# Comma-separated Telegram user IDs. Both lists are required for safe access control.
DELIVERY_MANAGER_IDS=111111111,222222222
DELIVERY_COURIER_IDS=333333333,444444444

# Telegram Business bot (a separate bot/token from the calls and delivery bots).
TELEGRAM_BUSINESS_ENABLED=false
TELEGRAM_BUSINESS_BOT_TOKEN=
# Optional when it can be derived from the numeric prefix of BOT_TOKEN.
TELEGRAM_BUSINESS_BOT_ID=
TELEGRAM_BUSINESS_WEBHOOK_SECRET=
TELEGRAM_BUSINESS_ALLOWED_CONNECTION_ID=
TELEGRAM_BUSINESS_ADMIN_CHAT_ID=
APP_TIMEZONE=Asia/Tashkent
BUSINESS_NIGHT_START=20:00
BUSINESS_NIGHT_END=09:30
BUSINESS_MANAGER_START=10:00
BUSINESS_MANAGER_END=20:00
# ISO weekdays, Monday=1 and Sunday=7. Default: all seven days.
BUSINESS_WORKDAYS=1,2,3,4,5,6,7
BUSINESS_FINAL_IDLE_SECONDS=300
BUSINESS_DEBOUNCE_SECONDS=3
BUSINESS_MANAGER_LOCK_MINUTES=120
BUSINESS_CREDIT_COOLDOWN_MINUTES=720
BUSINESS_MAX_MESSAGES_10M=4
BUSINESS_MAX_MESSAGES_SESSION=8
BUSINESS_DB_PATH=/app/data/business_telegram.db
GOOGLE_BUSINESS_SHEET_ID=13ZFPrYqtV9TQxzNEWsIgw3mX90eZny6sXGvDfpnTLeE
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_SHEETS_SYNC_INTERVAL_SECONDS=60
GOOGLE_TEMPLATE_CACHE_SECONDS=300
PRODUCT_SOURCE=existing_google_bot_prices
PRODUCT_DB_PATH=
PRODUCT_URLS_PATH=/app/data/Bot_URLS.xlsx
PRODUCT_PRICE_MAX_AGE_MINUTES=1440

# Optional call transcription and automatic lead-source detection.
# Keep disabled until an OpenAI API key is added in Coolify.
# Set the same random value in Coolify and in the Moizvonki webhook header
# X-Moizvonki-Webhook-Secret. If custom headers are unavailable, append
# ?secret=VALUE to the webhook URL.
MOIZVONKI_WEBHOOK_SECRET=
# Diagnostic switches. Keep true in normal operation. Set one or both to
# false temporarily to compare call delivery speed without automatic SMS.
AUTO_SMS_ENABLED=true
RATING_SMS_ENABLED=true
# Daily shop hours in Asia/Tashkent. Missed incoming calls outside this
# interval receive the bilingual closed-store SMS instead of the promo SMS.
MISSED_CALL_WORK_START=10:00
MISSED_CALL_WORK_END=20:00
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_TIMEOUT_SECONDS=180
TRANSCRIPTION_MAX_BYTES=26214400
TRANSCRIPTION_MAX_DURATION_SECONDS=1800
TRANSCRIPTION_MAX_ATTEMPTS=4
TRANSCRIPTION_LEASE_SECONDS=600
TRANSCRIPTION_POLL_SECONDS=5
TRANSCRIPTION_ALLOWED_HOSTS=.moizvonki.ru
