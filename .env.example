# Create a bot with @BotFather and add it to the delivery group and private
# location channel as an admin.
DELIVERY_BOT_TOKEN=123456:replace_me
DELIVERY_GROUP_ID=-1001234567890
DELIVERY_LOCATION_CHANNEL_ID=-1009876543210
DELIVERY_ORDERS_CHANNEL_ID=-1004459657817
DELIVERY_DB_PATH=data/delivery.db

# Comma-separated Telegram user IDs. Both lists are required for safe access control.
DELIVERY_MANAGER_IDS=111111111,222222222
DELIVERY_COURIER_IDS=333333333,444444444

# Passwordless manager portal. Register the exact origin and redirect URL in
# BotFather. Keep the web service at one replica while sessions use SQLite.
MONITORING_ENABLED=false
MONITORING_BASE_URL=https://bot.texnikach.uz/monitoring
MONITORING_SESSION_DB_PATH=/app/data/monitoring_sessions.db
MONITORING_SESSION_TTL_SECONDS=43200
MONITORING_IDLE_TTL_SECONDS=7200
# Optional: when empty, DELIVERY_MANAGER_IDS is used. Authorization always
# compares numeric Telegram IDs; usernames are never trusted for access.
MONITORING_MANAGER_IDS=
MONITORING_ADMIN_IDS=
MONITORING_MANAGER_REGISTRY_JSON=[]
MONITORING_TELEGRAM_CLIENT_ID=
MONITORING_TELEGRAM_CLIENT_SECRET=
MONITORING_TELEGRAM_REDIRECT_URI=https://bot.texnikach.uz/monitoring/auth/callback
MONITORING_DELIVERY_BASE_URL=http://texnikach-delivery-stats:8080
MONITORING_DELIVERY_SERVICE_TOKEN=
MONITORING_PRICE_BASE_URL=http://texnikach-price-web:8080
MONITORING_PRICE_SERVICE_TOKEN=
MONITORING_GO_API_URL=
MONITORING_GO_API_TOKEN=

# Telegram Business bot (a separate bot/token from the calls and delivery bots).
TELEGRAM_BUSINESS_ENABLED=false
TELEGRAM_BUSINESS_BOT_TOKEN=
# Optional when it can be derived from the numeric prefix of BOT_TOKEN.
TELEGRAM_BUSINESS_BOT_ID=
TELEGRAM_BUSINESS_WEBHOOK_SECRET=
TELEGRAM_BUSINESS_ALLOWED_CONNECTION_ID=
TELEGRAM_BUSINESS_ADMIN_CHAT_ID=
TELEGRAM_BUSINESS_ORDERS_CHAT_ID=-1004307725887
APP_TIMEZONE=Asia/Tashkent
BUSINESS_NIGHT_START=20:00
BUSINESS_NIGHT_END=09:30
BUSINESS_MANAGER_START=10:00
BUSINESS_MANAGER_END=20:00
# ISO weekdays, Monday=1 and Sunday=7. Default: all seven days.
BUSINESS_WORKDAYS=1,2,3,4,5,6,7
BUSINESS_FINAL_IDLE_SECONDS=300
BUSINESS_DEBOUNCE_SECONDS=3
BUSINESS_MANAGER_LOCK_MINUTES=120
BUSINESS_CREDIT_COOLDOWN_MINUTES=720
BUSINESS_MAX_MESSAGES_10M=4
BUSINESS_MAX_MESSAGES_SESSION=8
BUSINESS_DB_PATH=/app/data/business_telegram.db
GOOGLE_BUSINESS_SHEET_ID=13ZFPrYqtV9TQxzNEWsIgw3mX90eZny6sXGvDfpnTLeE
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_SHEETS_SYNC_INTERVAL_SECONDS=60
GOOGLE_TEMPLATE_CACHE_SECONDS=300
PRODUCT_SOURCE=existing_google_bot_prices
PRODUCT_DB_PATH=
PRODUCT_URLS_PATH=/app/data/Bot_URLS.xlsx
PRODUCT_PRICE_MAX_AGE_MINUTES=1440

# Password-protected price page, local synchronisation, Telegram publishing.
# Keep the feature disabled until every secret and the persistent DB volume are
# configured in Coolify. Use a dedicated Telegram bot token here.
PRICE_SERVER_ENABLED=false
PRICE_DB_PATH=/app/data/price_server.db
PRICE_LEGACY_HTML_PATH=/app/price/index.html
PRICE_ADMIN_USERNAME=admin
PRICE_ADMIN_PASSWORD=
PRICE_SYNC_API_KEY=
PRICE_TELEGRAM_BOT_TOKEN=
PRICE_TELEGRAM_CHANNEL_ID=
PRICE_TELEGRAM_CHANNEL_USERNAME=
PRICE_TELEGRAM_PREVIEW_CHANNEL_ID=
PRICE_PRODUCT_SORT_SHEET_ID=1Hiq-ccGGo3skcp0Imyw0Jum4OPilEs8lBJGApK6vlrs
PRICE_POSTS_SHEET_NAME=Telegram Posts
PRICE_POST_INDEX_SHEET_NAME=Price Post IDs
PRICE_CALENDAR_SHEET_NAME=Price Auto Schedule
PRICE_QUICK_LINKS_SHEET_NAME=Price Quick Links
PRICE_QUICK_LINK_ROTATIONS_SHEET_NAME=Price Quick Link Rotations
PRICE_BOT_SETTINGS_SHEET_ID=1TrS6C4oHe6nzQTPTa_4se_upXBFF6rmbfnE7RqznR8U
PRICE_BOT_SETTINGS_SHEET_NAME=bot_settings
PRICE_TIMEZONE=Asia/Tashkent
PRICE_SCHEDULER_POLL_SECONDS=5
PRICE_SCHEDULER_MODE=embedded
PRICE_DAILY_POST_REFRESH_ENABLED=true
PRICE_TELEGRAM_UPDATES_LIMIT=100
PRICE_SYNC_MAX_BYTES=10485760

# Optional call transcription and automatic lead-source detection.
# Keep disabled until an OpenAI API key is added in Coolify.
# Required for the calls-bot Telegram webhook and forwarding buttons. Register
# the same value with Telegram setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=
# Set the same random value in Coolify and append ?secret=VALUE to every
# Moizvonki webhook URL. Query parameters are the documented provider option;
# Uvicorn access logs redact query strings in this application.
MOIZVONKI_WEBHOOK_SECRET=
# Call-channel posts are silent. An incoming missed call additionally
# mentions this Telegram username.
MISSED_CALL_ALERT_USERNAME=@AbbosTch
# Daily forwarding control post in the calls channel. Commands are accepted
# only from these numeric Telegram IDs and only from the current pinned post.
# Both webhook secrets above must be configured; forwarding fails closed when
# either source is not authenticated.
# Keep disabled: calls.make_call accepts phone numbers, but the current
# Android app cannot transport # in an MMI command without corrupting it.
FORWARDING_ENABLED=false
# Full-access administrators. Abbos (202134293) is always included.
FORWARDING_ADMIN_IDS=202134293
# Per-phone controllers. They can operate only their assigned source phone.
FORWARDING_REDMI_CONTROLLER_IDS=7636344727
FORWARDING_TECNO_CONTROLLER_IDS=702960146
FORWARDING_POST_TIME=20:00
FORWARDING_POLL_SECONDS=2
FORWARDING_COMMAND_COOLDOWN_SECONDS=90
FORWARDING_CONFIRM_TIMEOUT_SECONDS=120
FORWARDING_CORRELATION_WINDOW_SECONDS=300
# Diagnostic switches. Keep true in normal operation. Set one or both to
# false temporarily to compare call delivery speed without automatic SMS.
AUTO_SMS_ENABLED=true
RATING_SMS_ENABLED=true
# Daily shop hours in Asia/Tashkent. Missed incoming calls outside this
# interval receive the bilingual closed-store SMS instead of the promo SMS.
MISSED_CALL_WORK_START=10:00
MISSED_CALL_WORK_END=20:00
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_TIMEOUT_SECONDS=180
TRANSCRIPTION_MAX_BYTES=26214400
TRANSCRIPTION_MAX_DURATION_SECONDS=1800
TRANSCRIPTION_MAX_ATTEMPTS=4
TRANSCRIPTION_LEASE_SECONDS=600
TRANSCRIPTION_POLL_SECONDS=5
TRANSCRIPTION_ALLOWED_HOSTS=.moizvonki.ru
