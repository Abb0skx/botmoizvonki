# Runtime secrets, never Docker build arguments. chmod 600 the real env file.
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_GRAPH_BASE_URL=https://graph.instagram.com/v26.0
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_MANAGER_IDS=
DATABASE_URL=sqlite:////data/inbox.db
CONTEXT_MESSAGES=20
INSTAGRAM_RULES_SHEET_ID=1ZdSyTJr9jSBdBDUZowXi2CpjTb7GZMQCQNsMRCMjywk
INSTAGRAM_DIRECT_RULES_SHEET_NAME=direct_rules
INSTAGRAM_DIRECT_SETTINGS_SHEET_NAME=direct_settings
INSTAGRAM_PRODUCTS_SHEET_ID=1TrS6C4oHe6nzQTPTa_4se_upXBFF6rmbfnE7RqznR8U
INSTAGRAM_PRODUCTS_SHEET_NAME=bot_prices
INSTAGRAM_SETTINGS_SHEET_NAME=bot_settings
SHEETS_CACHE_SECONDS=60
# New messages only. Activation time is a fixed UTC Unix timestamp, not reset on restart.
AUTO_PRICE_ENABLED=false
AUTO_PRICE_SINCE=0
# UTC activation timestamp: only newer manager Replies send without confirmation.
# 0 keeps the previous confirmation flow. Never reset to a past timestamp.
DIRECT_REPLY_SINCE=0
INCOMING_DEBOUNCE_SECONDS=4
TOPIC_CLOSE_AFTER_HOURS=72
WORKER_LOCK_PATH=/data/worker.lock
LEGACY_INSTAGRAM_WEBHOOK_URL=http://texnikach-calls-service:8000/webhooks/instagram
